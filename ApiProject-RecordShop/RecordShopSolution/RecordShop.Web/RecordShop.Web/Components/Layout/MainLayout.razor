@inherits LayoutComponentBase

<div class="page">
   

    <header>
        <h1>Welcome to MyRecordShop</h1>
        <p>This is placeholder for welcome tagline</p>
        <NavMenu />
    </header>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<footer>
    ZH, @DateTime.Now.Year
</footer>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
